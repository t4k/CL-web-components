*.tmp
*.bak
*.swp
*.env

# Build and output directories
bin/
dist/
scratch/

# Generated from codemeta.json by `deno task version`, which `deno task build`
# runs first. Tracked previously, which is why it shipped 0.0.12 for four
# releases -- nothing regenerated it.
/src/version.js

# Generated documentation
# .github/workflows/docs.yml assembles the published site into _site/,
# including the Pagefind index, and deploys it. Never committed.
/_site/

# macOS system files
.DS_Store

# Bash Scripts
server.sh

# specific files

demo_footer_presets.html
